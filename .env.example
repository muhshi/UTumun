# Kredensial Login UT E-learning (Wajib untuk fitur sinkronisasi / scraper)
UT_USERNAME=01007726
UT_PASSWORD=
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Pilihan Mesin Database: 'mysql' (untuk server) atau 'sqlite' (default lokal)
DB_ENGINE=sqlite

# Konfigurasi MySQL Server (Diisi jika DB_ENGINE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tuton_db
